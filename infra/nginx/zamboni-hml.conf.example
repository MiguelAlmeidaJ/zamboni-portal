limit_req_zone $binary_remote_addr zone=zamboni_login:10m rate=10r/m;

server {
    listen 80;
    listen [::]:80;
    server_name hmlzamboni.nivel3ti.com.br apibzamboni.nivel3ti.com.br;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name hmlzamboni.nivel3ti.com.br;

    ssl_certificate /etc/letsencrypt/live/hmlzamboni.nivel3ti.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/hmlzamboni.nivel3ti.com.br/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;

    location / {
        proxy_pass http://127.0.0.1:3330;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name apibzamboni.nivel3ti.com.br;

    ssl_certificate /etc/letsencrypt/live/apibzamboni.nivel3ti.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/apibzamboni.nivel3ti.com.br/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    client_max_body_size 20k;

    location = /api/consulta {
        limit_req zone=zamboni_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:3331;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
    }

    location / {
        proxy_pass http://127.0.0.1:3331;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
    }
}
